// Code generated by oto; DO NOT EDIT.

'use strict';

/**
 * Errors thrown by client methods include network failures or server errors.
 */

<%= for (service) in def.Services { %>
<%= for (method) in service.Methods { %>
/**
 * @typedef {Object} <%= service.Name %><%= method.Name %>Request
<%= for (object) in def.Objects { %>
<%= if (object.Name == method.InputObject.CleanObjectName) { %>
<%= for (field) in object.Fields { %>
 * @property {<%= field.Type.JSType %><%= if (field.Type.Multiple) { %>[]<% } %>} <%= field.NameLowerCamel %><%= if (field.Comment != "") { %> - <%= format_comment_line(field.Comment) %><% } %>
<% } %>
<% } %>
<% } %>
 */
/**
 * @typedef {Object} <%= service.Name %><%= method.Name %>Response
<%= for (object) in def.Objects { %>
<%= if (object.Name == method.OutputObject.CleanObjectName) { %>
<%= for (field) in object.Fields { %>
 * @property {<%= field.Type.JSType %><%= if (field.Type.Multiple) { %>[]<% } %>} <%= field.NameLowerCamel %><%= if (field.Comment != "") { %> - <%= format_comment_line(field.Comment) %><% } %>
<% } %>
<% } %>
<% } %>
 */
<% } %>
<% } %>

export const client = {
<%= for (service) in def.Services { %>
	<%= if (service.Comment != "") { %>
	/**
	 * <%= format_comment_line(service.Comment) %>
	 */
	<% } %>
	<%= service.Name %>: {
		<%= for (method) in service.Methods { %>
		/**
		<%= if (method.Comment != "") { %>
		 * <%= format_comment_line(method.Comment) %>
		<% } %>
		 * @param {<%= service.Name %><%= method.Name %>Request} [request]
		 * @returns {Promise<<%= service.Name %><%= method.Name %>Response>}
		 */
		async <%= camelize_down(method.Name) %>(request) {
			const headers = {
				'Accept': 'application/json',
				'Content-Type': 'application/json',
			}
			request = request || {}
			const response = await fetch('/oto/<%= service.Name %>.<%= method.Name %>', {
				method: 'POST',
				headers: headers,
				body: JSON.stringify(request)
			})
			const text = await response.text()
			let json = null
			if (text) {
				try {
					json = JSON.parse(text)
				} catch (e) {
					if (!response.ok) {
						throw new Error(`<%= service.Name %>.<%= method.Name %>: ${response.status} ${response.statusText}`)
					}
					throw e
				}
			}
			if (!response.ok) {
				if (json && json.error) {
					throw new Error(json.error)
				}
				throw new Error(`<%= service.Name %>.<%= method.Name %>: ${response.status} ${response.statusText}`)
			}
			return json || {}
		}
		<% } %>
	},
<% } %>
}
